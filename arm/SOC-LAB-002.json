{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "type": "string",
      "metadata": {
        "description": "Existing Sentinel Log Analytics workspace"
      }
    },
    "ruleId": {
      "type": "string",
      "defaultValue": "a18019dc-19ff-4795-842d-183b233b3c4f"
    }
  },
  "resources": [
    {
      "type": "Microsoft.SecurityInsights/alertRules",
      "apiVersion": "2022-11-01",
      "scope": "[format('Microsoft.OperationalInsights/workspaces/{0}', parameters('workspaceName'))]",
      "name": "[parameters('ruleId')]",
      "kind": "Scheduled",
      "properties": {
        "displayName": "SOC-LAB-002 - Azure RBAC Role Assignment Monitoring",
        "description": "Monitors successful Azure role assignment writes, regardless of privilege level.",
        "severity": "Low",
        "query": "// SOC-LAB-002: Azure RBAC Role Assignment Monitoring\n// Status: Rule created, disabled\n// Data source: AzureActivity\n// Severity: Low\n// Validation: Synthetic KQL testing\n// Scope: Successful role assignments, not privileged roles only\n\nAzureActivity\n| where TimeGenerated > ago(2h)\n| where OperationNameValue =~\n    \"MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE\"\n| where ActivityStatusValue in~ (\"Success\", \"Succeeded\")\n| summarize arg_max(TimeGenerated, *)\n    by CorrelationId, ResourceId, Caller\n| project\n    TimeGenerated,\n    Caller,\n    CallerIpAddress,\n    OperationNameValue,\n    ActivityStatusValue,\n    ResourceId,\n    ResourceGroup,\n    CorrelationId\n| order by TimeGenerated desc\n",
        "queryFrequency": "PT1H",
        "queryPeriod": "PT2H",
        "triggerOperator": "GreaterThan",
        "triggerThreshold": 0,
        "suppressionEnabled": false,
        "suppressionDuration": "PT5H",
        "tactics": [],
        "techniques": [],
        "entityMappings": [
          {
            "entityType": "Account",
            "fieldMappings": [
              {
                "identifier": "FullName",
                "columnName": "Caller"
              }
            ]
          },
          {
            "entityType": "IP",
            "fieldMappings": [
              {
                "identifier": "Address",
                "columnName": "CallerIpAddress"
              }
            ]
          },
          {
            "entityType": "AzureResource",
            "fieldMappings": [
              {
                "identifier": "ResourceId",
                "columnName": "ResourceId"
              }
            ]
          }
        ],
        "enabled": false,
        "incidentConfiguration": {
          "createIncident": false,
          "groupingConfiguration": {
            "enabled": false,
            "groupByAlertDetails": [],
            "groupByCustomDetails": [],
            "groupByEntities": [],
            "lookbackDuration": "PT5H",
            "matchingMethod": "AllEntities",
            "reopenClosedIncident": false
          }
        },
        "eventGroupingSettings": {
          "aggregationKind": "AlertPerResult"
        }
      }
    }
  ]
}
