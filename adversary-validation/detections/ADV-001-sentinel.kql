// ADV-001: Controlled PowerShell telemetry validation
// MITRE ATT&CK: T1059.001 (PowerShell)
// Source: genuine Windows Security Event 4688 records
// Ingestion: manually forwarded through Azure Monitor Logs Ingestion API
// This validates a lab-marker detector, not malicious PowerShell behavior.

let Evaluated =
    SOCSecurityEvents_CL
    | where TimeGenerated between (
        datetime(2026-11-07T00:00:00Z) ..
        datetime(2026-11-10T00:00:00Z)
    )
    | where EventType == "WindowsProcessCreation"
    | where Action == "ProcessCreated"
    | where Destination endswith @"\powershell.exe"
    | extend DetectorMatched =
        CorrelationId == "ADV-001-20261106-205332";
let PositiveObserved =
    toscalar(
        Evaluated
        | where CorrelationId == "ADV-001-20261106-205332"
        | count
    );
let PositiveDetected =
    toscalar(
        Evaluated
        | where CorrelationId == "ADV-001-20261106-205332"
        | where DetectorMatched
        | count
    );
let BenignObserved =
    toscalar(
        Evaluated
        | where CorrelationId == "BENIGN-4688-95761"
        | count
    );
let BenignDetected =
    toscalar(
        Evaluated
        | where CorrelationId == "BENIGN-4688-95761"
        | where DetectorMatched
        | count
    );
print
    PositiveObserved,
    PositiveDetected,
    BenignObserved,
    BenignDetected,
    PositiveTest = iff(
        PositiveObserved >= 1 and PositiveDetected >= 1,
        "PASS", "FAIL"
    ),
    NegativeTest = iff(
        BenignObserved >= 1 and BenignDetected == 0,
        "PASS", "FAIL"
    )
