// ADV-001 — Controlled PowerShell execution validation
// MITRE ATT&CK: T1059.001
// Source: SOCSecurityEvents_CL
// Genuine Windows 4688 event forwarded through the Logs Ingestion API.
// This is a lab-marker test, not a general malicious PowerShell detector.

let LabEvents =
    SOCSecurityEvents_CL
    | where TimeGenerated between (
        datetime(2026-11-07T02:00:00Z) ..
        datetime(2026-11-07T04:00:00Z)
    );
let Positive =
    toscalar(
        LabEvents
        | where EventType == "WindowsProcessCreation"
        | where Action == "ProcessCreated"
        | where Destination endswith @"\powershell.exe"
        | where CorrelationId == "ADV-001-20261106-205332"
        | count
    );
let Negative =
    toscalar(
        LabEvents
        | where EventType == "WindowsProcessCreation"
        | where Action == "ProcessCreated"
        | where Destination endswith @"\powershell.exe"
        | where CorrelationId == "ADV-001-DOES-NOT-EXIST"
        | count
    );
print
    PositiveMatches = Positive,
    NegativeMatches = Negative,
    PositiveTest = iff(Positive >= 1, "PASS", "FAIL"),
    NegativeTest = iff(Negative == 0, "PASS", "FAIL")
