
AzureActivity
| where TimeGenerated > ago(2h)
| where OperationNameValue =~ "MICROSOFT.AUTHORIZATION/ROLEASSIGNMENTS/WRITE"
| where ActivityStatusValue in~ ("Success", "Succeeded")
| summarize arg_max(TimeGenerated, *) by CorrelationId, ResourceId, Caller
| project
    TimeGenerated,
    Caller,
    CallerIpAddress,
    OperationNameValue,
    ActivityStatusValue,
    ResourceId,
    ResourceGroup,
    CorrelationId
| order by TimeGenerated desc
